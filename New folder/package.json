{
  "name": "exam-blueprint-generator-(tamil)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm run build:question-paper-server && node server/index.js",
    "backend": "npm run build:question-paper-server && nodemon server/index.js",
    "dev:all": "concurrently --kill-others \"npm run dev\" \"npm run backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:question-paper": "node scripts/run-question-paper-tests.mjs",
    "build:question-paper-server": "node scripts/build-question-paper-server-bundle.mjs"
  },
